# SQLite is the default. Do not commit .env or data/.
# SPATIAL_DATA_DIR=C:/SpatialLensData
# DATABASE_URL=postgresql+psycopg://username:password@localhost/spatiallens
# Set only behind an HTTPS reverse proxy (cookies then require HTTPS).
COOKIE_SECURE=false
# Comma-separated hostnames, not origins. Local deployment is the default.
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
